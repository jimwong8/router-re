# 构建产物
mgmtd/bin/
web/node_modules/
web/dist/
# 误编到仓库根的二进制（应在 cmd 下 go build 到 bin/ 或 /tmp）
/mgmtd/mgmtd
/mgmtd/router-cloud
/mgmtd/router-agent
# 本地实验工作区
/workspace/
# 环境
.env

# 监控运行时产物
logs/

# 运行时审计日志（每次跑 E2E 都会增长，不该进仓库）
audit.jsonl
ops/tasks.jsonl.bak-*

# 运行时产物：调度状态和任务队列（含进度/retry，不该进仓库）
.dispatch-state.json
ops/tasks.jsonl
docs/write-endpoint-audit.md

# 任务完成标记（工人用来给无文件产出的任务一个信号）
.p*-done
ops/lane-*.json
ops/.lane-watch-state.json
ops/backlog.jsonl
ops/*.hb
